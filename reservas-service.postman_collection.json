  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Genera un X-Trace-Id único (UUID v4) por cada request",
          "function generateUUID() {",
          "    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
          "        var r = Math.random() * 16 | 0;",
          "        var v = c === 'x' ? r : (r & 0x3 | 0x8);",
          "        return v.toString(16);",
          "    });",
          "}",
          "pm.collectionVariables.set('traceId', generateUUID());",
          "console.log('[TraceId generado]', pm.collectionVariables.get('traceId'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Extrae y muestra el X-Trace-Id que devuelve el servidor en la respuesta",
          "const traceIdResponse = pm.response.headers.get('X-Trace-Id');",
          "if (traceIdResponse) {",
          "    pm.collectionVariables.set('lastResponseTraceId', traceIdResponse);",
          "    console.log('[X-Trace-Id respuesta]', traceIdResponse);",
          "    pm.test('X-Trace-Id presente en respuesta', () => pm.expect(traceIdResponse).to.not.be.empty);",
          "}"
        ]
      }
    }
  ],
